{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphite",
  "version": "1.3.0",
  "identifier": "com.graphite.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graphite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0D0E11"
      },
      {
        "label": "capture",
        "url": "index.html?window=capture",
        "title": "Быстрая запись",
        "width": 480,
        "height": 184,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      },
      {
        "label": "note",
        "url": "index.html?window=note",
        "title": "Заметка — Graphite",
        "width": 760,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0D0E11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Hjgyhfyh/graphite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQjE5QzJCODY3OUE1QkIKUldTN3BYbUdLNXl4MmtTOUtkMHp1VG5wTTRiaUE3bm1DWEpLYTFXUnBMY2xvT0V3ZlAwWnd5cmIK"
    }
  }
}
