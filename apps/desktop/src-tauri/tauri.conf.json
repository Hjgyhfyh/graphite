{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphite",
  "version": "0.1.0",
  "identifier": "com.graphite.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graphite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0D0E11"
      },
      {
        "label": "capture",
        "url": "index.html?window=capture",
        "title": "Быстрая запись",
        "width": 480,
        "height": 184,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  }
}
