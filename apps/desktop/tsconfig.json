{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@graphite/ui": ["../../packages/ui/src/index.ts"],
      "@graphite/ui/*": ["../../packages/ui/src/*"],
      "@graphite/editor": ["../../packages/editor/src/index.ts"],
      "@graphite/editor/*": ["../../packages/editor/src/*"],
      "@graphite/bindings": ["../../packages/bindings/src/index.ts"],
      "@graphite/bindings/*": ["../../packages/bindings/src/*"]
    },
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts"]
}
